# ── Supabase (문항 저장·조회) ─────────────────────────────
# Supabase 대시보드 → Settings → API 에서 복사
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google (학생 결과 저장용 시트 + 기존 문항 이사) ────────
# 서비스 계정 JSON 전체를 한 줄로
GCP_CREDENTIALS=
# 기존 마스터 문항 시트 이름 (이사 스크립트에서만 사용)
GOOGLE_SHEET_NAME=서술형 평가 문항

# ── OpenAI (AI 채점·피드백) ───────────────────────────────
OPENAI_API_KEYS=
LIBRARY_VECTORSTORE_ID=
